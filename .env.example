# 复制为 .env 后按需修改；切勿把真实密钥写回本文件
DATABASE_URL=postgresql+psycopg://talent:talent_dev_password@localhost:15432/talent_docs
S3_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY=talent_minio
S3_SECRET_KEY=talent_minio_password
S3_BUCKET=talent-documents
REDIS_URL=redis://localhost:16379/0
MINERU_URL=http://127.0.0.1:18001
# 必填：百炼 / DashScope 的 API Key（未填写时对话模型不可用）
DASHSCOPE_API_KEY=请用户自行填写
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
MILVUS_URI=http://localhost:19531
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=talent_evidence_v2
# 可选：评测 Judge 走独立模型/端点，三项全填才生效（留空则 /api/evaluation/judge 不可用）
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=
